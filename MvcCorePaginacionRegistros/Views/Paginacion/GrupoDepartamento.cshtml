@model List<Departamento>

@{
    int registros = (int)ViewData["REGISTROS"];
    int numeroPagina = 1;
}

<h1 style="color:blue">Paginacion en grupo Procedure</h1>

<hr />
@for (int x = 1; x <= registros; x += 2)
{
    <a class="btn btn-success" asp-controller="Paginacion" asp-action="GrupoDepartamento" asp-route-posicion="@x">Pagina @numeroPagina</a>
    numeroPagina++;
}
<hr />

<table class="table table-striped">
    <thead>
        <tr>
            <th>id</th>
            <th>Nombre</th>
            <th>Localidad</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Departamento item in Model)
        {
            <tr>
                <td>@item.IdDepartamento</td>
                <td>@item.Nombre</td>
                <td>@item.Localidad</td>
            </tr>
        }
    </tbody>
</table>