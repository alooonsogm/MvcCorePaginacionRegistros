@model List<VistaDepartamento>

@{
    int registros = (int)ViewData["REGISTROS"];
    int numeroPagina = (int)ViewData["NUMEROPAGINA"];
}

<h1>Paginacion en grupo</h1>

<hr />
@for(int x = 1; x<= registros; x+=2)
{
    <a class="nav-link text-dark" asp-area="" asp-controller="Paginacion" asp-action="GrupoVistaDepartamento" asp-route-posicion="@x">Pagina @numeroPagina</a>
    numeroPagina++;
}
<hr />

<table class="table table-striped">
    <thead>
        <tr>
            <th>Posicion</th>
            <th>id</th>
            <th>Nombre</th>
            <th>Localidad</th>
        </tr>
    </thead>
    <tbody>
        @foreach (VistaDepartamento item in Model)
        {
            <tr>
                <td>@item.Posicion</td>
                <td>@item.IdDepartamento</td>
                <td>@item.Nombre</td>
                <td>@item.Localidad</td>
            </tr>
        }
    </tbody>
</table>